<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=\, initial-scale=1.0">
    <title>Edit your chat</title>
</head>
<body>
    <h3>Edit your Chat: <%= chat._id %></h3>
    <p>This chat was sent from <B> <%= chat.from %> </b> to <b> <%= chat.to %> </B> </p>

    <form action="/chats/<%= chat._id %>?_method=PUT" method="post" >
        <textarea name="msg" rows="15" cols="50" id=""><%= chat.msg %></textarea> <br><br>
        <button>Edit</button>
    </form>
</body>
</html>